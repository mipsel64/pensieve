<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.mipsel64.pensieve</string>
    <key>UserName</key>
    <string>__USER__</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>set -a; . "$0"; exec "$1" serve</string>
        <string>__HOME__/.config/pensieve/environment</string>
        <string>__HOME__/.local/bin/pensieve-server</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/pensieve/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/pensieve/stderr.log</string>
</dict>
</plist>
