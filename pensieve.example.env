# Server settings, read by `make setup`'s launchd and systemd services from
# ~/.config/pensieve/environment (created from this file with a random token).
# Plain KEY=value lines only: systemd reads them as an EnvironmentFile, launchd via sh.
PENSIEVE_TOKEN=
# PENSIEVE_LISTEN=127.0.0.1:7878
# PENSIEVE_DB=/path/to/pensieve.db
# PENSIEVE_JEV_KEY=
# PENSIEVE_JEV_PROVIDER=vercel
